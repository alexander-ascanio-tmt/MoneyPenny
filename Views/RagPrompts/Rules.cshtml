@model IEnumerable<MoneyPenny.Models.Rag.RagPromptSelectionRule>
@{
    ViewData["Title"] = "Reglas de selección RAG";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="mb-1">@ViewData["Title"]</h2>
        <p class="text-muted mb-0 small">Mayor prioridad gana. Deja urgencia o intención vacíos para «cualquiera».</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Plantillas</a>
        <a asp-action="CreateRule" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Nueva regla
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success border-0 shadow-sm">@success</div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Prioridad</th>
                    <th>Nombre</th>
                    <th>Urgente</th>
                    <th>Intención</th>
                    <th>Plantilla</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Priority</td>
                    <td>@(item.Name ?? "—")</td>
                    <td>
                        @if (item.IsUrgent is null)
                        {
                            <span class="text-muted">Cualquiera</span>
                        }
                        else if (item.IsUrgent == true)
                        {
                            <span class="badge text-bg-danger">Sí</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">No</span>
                        }
                    </td>
                    <td><code>@(item.IntentCode ?? "cualquiera")</code></td>
                    <td>@item.PromptTemplate.Name</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge text-bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactiva</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="EditRule" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form asp-action="DeleteRule" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No hay reglas. Se usará la plantilla <code>default</code>.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
