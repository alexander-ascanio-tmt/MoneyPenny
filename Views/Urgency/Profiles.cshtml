@model IEnumerable<MoneyPenny.Models.Rag.UrgencyProfile>
@{
    ViewData["Title"] = "Instrucciones de respuesta (urgencia)";
}

<h2 class="mb-3">@ViewData["Title"]</h2>
<p class="text-muted">Texto adicional al prompt RAG cuando el ticket está marcado como urgente (plantilla <code>agent</code>). En tickets normales no se añade bloque de urgencia.</p>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success border-0 shadow-sm">@success</div>
}

<form asp-action="Profiles" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        @foreach (var profile in Model)
        {
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white">
                        <strong>@profile.Name</strong> <code class="small">@profile.Code</code>
                    </div>
                    <div class="card-body">
                        <textarea name="instructions_@profile.Id"
                                  class="form-control font-monospace small"
                                  rows="10">@profile.ResponseInstructions</textarea>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver a frases</a>
    </div>
</form>
